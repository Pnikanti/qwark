# Upstream download cache — regenerable by scripts/build-movements.py.
# The built output in data/ is committed, so nothing is lost by ignoring this.
.cache/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Firebase deploy cache and CLI debug output
.firebase/
firebase-debug.log
*-debug.log

# Agent tooling — machine-local, not part of the app
.agents/
skills-lock.json
.claude/settings.local.json
.claude/skills/

# Environment
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Python
__pycache__/
*.py[cod]

# TypeScript incremental build info
*.tsbuildinfo
